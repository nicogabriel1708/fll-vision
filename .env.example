# ==============================================================================
# FLL-Vision Environment Configuration (.env)
# Run `./setup.sh` to generate `.env` and initialize the database interactively
# or via CLI arguments. No default passwords exist.
# ==============================================================================

# Web Server Port
FLL_PORT=8080

# Admin Panel (/admin, Login: /login/admin) Credentials (REQUIRED)
FLL_ADMIN_USER=admin
FLL_ADMIN_PASSWORD=

# Volunteer Control (/control, Login: /login/control) Credentials (OPTIONAL)
FLL_VOLUNTEERS_USER=volunteers
FLL_VOLUNTEERS_PASSWORD=

# System Configuration (/configuration, Login: /login/configuration) Credentials (OPTIONAL)
FLL_ENGINEERS_USER=engineers
FLL_ENGINEERS_PASSWORD=
